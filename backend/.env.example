PORT=5000
MONGO_URI=mongodb://localhost:27017/complaint_management

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Codes required to self-register as an agent or admin; keep these private
AGENT_SIGNUP_CODE=
ADMIN_SIGNUP_CODE=
MAX_ADMIN_ACCOUNTS=2

# Optional AI features (free key from https://build.nvidia.com — sign in, open any model, "Get API Key")
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-nemotron
